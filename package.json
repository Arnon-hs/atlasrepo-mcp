{
  "name": "atlasrepo-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP connector for the AtlasRepo open-source decision catalog",
  "license": "MIT",
  "type": "module",
  "bin": {
    "atlasrepo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "start:http": "node dist/http.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test": "node --test --import tsx tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "atlasrepo",
    "mcp",
    "codex",
    "claude",
    "open-source",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arnon-hs/atlasrepo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Arnon-hs/atlasrepo-mcp/issues"
  },
  "homepage": "https://atlasrepo.com",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
